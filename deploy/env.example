# Copy to /opt/oshwdem-live/.env on the server. Never commit the real one.

# Name of the existing Docker network your Caddy container is attached to.
# Find it with:
#   docker inspect <caddy-container> \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
CADDY_NETWORK=

# Managed by deploy.sh — set these to a real tag before the first `up`.
PROD_TAG=sha-0000000
DEV_TAG=sha-0000000
